STEAM_API_KEY=your_key_here

# shared
DB_PATH=steam_state.db

# build_queue.py
MAX_RESULTS=50000

# fetch_data.py
OUTPUT_DIR=steam_data
REQUEST_INTERVAL=2        # seconds between API calls
RATE_LIMIT_WAIT=180       # seconds to wait after a rate-limit response
MIN_REVIEWS=100
TOP_N=10
LIMIT=0                   # stop after N apps this run (0 = no limit)